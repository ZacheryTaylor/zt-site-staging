{#- Compact "Active projects" list. Set `apId` (unique per page) and, optionally,
    `apSkipApps = true` (Life & Interests, where apps already have cards). -#}
<section class="band ap-band" id="active-projects" aria-labelledby="{{ apId }}-title">
  <div class="wrap">
    <h2 class="ap-title" id="{{ apId }}-title">Active projects</h2>
    <ul class="ap-list">
      {%- for f in activeProjects.items %}{% if not (apSkipApps and f.app) %}
      <li>
        <span class="ap-name">{% if f.href %}<a href="{{ f.href }}"{% if f.external %} target="_blank" rel="noopener"{% endif %}>{{ f.title }}{% if f.external %}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span>{% endif %}</a>{% else %}{{ f.title }}{% endif %}</span>
        <span class="ap-text">{{ f.text }}{% if f.id == "products" %} Categories: {% for g in activeProjects.productGroups %}{{ g.title }}{{ ", " if not loop.last else "." }}{% endfor %}{% endif %}</span>
        <span class="ap-status">{{ f.status }}</span>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>
