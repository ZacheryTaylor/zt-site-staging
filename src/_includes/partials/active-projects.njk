{#- Active projects board. Set `apId` (unique per page) and `apSheet` before including. -#}
<section class="band" id="active-projects" aria-labelledby="{{ apId }}-title">
  <div class="wrap">
    {{ ui.sectionLabel(apSheet, "Active projects") }}
    <h2 id="{{ apId }}-title">What I’m <em>building now.</em></h2>
    <p class="section-intro">Tools, products, and books I’m working on through ZT, LLC, alongside my civil design work.</p>
    <ol class="now-board ap-board">
      {%- for f in activeProjects.items %}
      <li class="now-item ap-item reveal">
        <div class="now-meta">
          <span class="now-no">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span>
          <span class="now-label">{{ f.label }}</span>
        </div>
        <div class="now-body">
          <h3>{% if f.href %}<a href="{{ f.href }}"{% if f.external %} target="_blank" rel="noopener"{% endif %}>{{ f.title }}{% if f.external %}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span>{% endif %}</a>{% else %}{{ f.title }}{% endif %}</h3>
          <p>{{ f.text }}</p>
          {%- if f.id == "products" %}
          <dl class="ap-groups">
            {%- for g in activeProjects.productGroups %}
            <div>
              <dt>{{ g.title }}</dt>
              <dd>{%- for h in g.hrefs %}{% for p in civil.products %}{% if p.href == h %}<a href="{{ p.href }}" target="_blank" rel="noopener">{{ p.title }}</a>{% endif %}{% endfor %}{% endfor %}</dd>
            </div>
            {%- endfor %}
          </dl>
          <p class="ap-more"><a class="text-link" href="{{ f.href }}">{{ f.hrefLabel }}</a> <a class="text-link" href="{{ civil.productStore }}" target="_blank" rel="noopener">Gumroad shop<span class="visually-hidden"> (opens in a new tab)</span></a></p>
          {%- endif %}
        </div>
        <div class="now-status">
          <span class="status status-{{ f.tone }}">{{ f.status }}</span>
        </div>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
