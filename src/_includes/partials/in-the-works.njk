{#- Life & Interests: "In the works", early projects with no page or link (activeProjects items with group "inworks"). Set `iwSheet`. -#}
<section class="band iw-band" id="in-the-works" aria-labelledby="iw-title">
  <div class="wrap">
    {{ ui.sectionLabel(iwSheet, "In the works") }}
    <h2 id="iw-title">In the <em>works.</em></h2>
    <ul class="iw-list">
      {%- for a in activeProjects.items %}{% if a.group == "inworks" %}
      <li class="iw-item reveal">
        {%- if a.cover %}<div class="iw-cover"><img src="/{{ a.cover }}" alt="" width="600" height="400" loading="lazy" decoding="async"></div>{% endif %}
        <div class="iw-body">
          <p class="iw-kicker">{{ a.type }}</p>
          <h3>{{ a.title }}{% if a.titleNote %} <span class="card-title-note">({{ a.titleNote }})</span>{% endif %}</h3>
          <p>{{ a.text }}</p>
          <p class="iw-status"><span class="status status-scheduled">{{ a.status }}</span></p>
        </div>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>
