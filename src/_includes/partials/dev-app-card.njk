{#- Plain project card (no project page). Same look as ui.projectCard. `a` = activeProjects item.
    Optional: titleNote, coverAlt, disclaimer, credit, features (=> Quick view dialog, see plain-dialog.njk). -#}
<li class="project-card reveal">
  <div class="project-cover"><span class="project-type">{{ a.type }}</span>{% if a.cover %}<img src="/{{ a.cover }}" alt="{{ a.coverAlt or '' }}" width="{{ 1200 if a.cover.endsWith('.jpg') else 600 }}" height="{{ 800 if a.cover.endsWith('.jpg') else 400 }}" loading="lazy" decoding="async">{% endif %}</div>
  <div class="project-body">
    <p class="project-date">{{ a.status }}</p>
    <h3>{% if a.href %}<a href="{{ a.href }}">{{ a.title }}</a>{% else %}{{ a.title }}{% endif %}{% if a.titleNote %} <span class="card-title-note">({{ a.titleNote }})</span>{% endif %}</h3>
    <p>{{ a.text }}</p>
    {%- if a.disclaimer %}<p class="card-fine">{{ a.disclaimer }}</p>{% endif %}
    {%- if a.credit %}<p class="card-fine card-credit">{{ a.credit }}</p>{% endif %}
    {%- if a.features %}
    <div class="card-actions"><button class="card-button" type="button" data-dialog="dlg-{{ a.id }}" aria-haspopup="dialog">Quick view<span class="visually-hidden">: {{ a.title }}</span></button></div>
    {%- elif a.href %}
    <div class="card-actions"><a class="card-button" href="{{ a.href }}">{{ a.hrefLabel or "Open" }}<span class="visually-hidden">: {{ a.title }}</span></a></div>
    {%- endif %}
  </div>
</li>
