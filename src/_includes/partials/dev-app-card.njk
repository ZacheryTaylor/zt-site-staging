{#- Card for an app still in development (no project page, no link). Same look as ui.projectCard. `a` = activeProjects item. -#}
<li class="project-card reveal">
  <div class="project-cover"><span class="project-type">{{ a.type }}</span></div>
  <div class="project-body">
    <p class="project-date">{{ a.status }}</p>
    <h3>{{ a.title }}</h3>
    <p>{{ a.text }}</p>
  </div>
</li>
